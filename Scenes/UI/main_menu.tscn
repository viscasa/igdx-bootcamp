[sub_resource type="Shader" id="Shader_pattern_mask"]
code = "shader_type canvas_item;

uniform sampler2D pattern_texture : repeat_enable, filter_linear_mipmap;
uniform sampler2D mask_texture : filter_linear_mipmap;
uniform float pattern_scale : hint_range(0.25, 2.0, 0.01) = 0.65;
uniform float pattern_rotation_degrees : hint_range(-180.0, 180.0, 0.1) = 41.0;
uniform vec2 scroll_offset = vec2(0.0, 0.0);

vec2 rotate_point(vec2 point, float angle) {
	float cosine = cos(angle);
	float sine = sin(angle);
	return vec2(
		cosine * point.x - sine * point.y,
		sine * point.x + cosine * point.y
	);
}

void fragment() {
	vec2 mask_size = vec2(textureSize(mask_texture, 0));
	vec2 pattern_size = vec2(textureSize(pattern_texture, 0));
	vec2 mask_position = (UV - vec2(0.5)) * mask_size;
	vec2 rotated_position = rotate_point(mask_position, radians(-pattern_rotation_degrees));
	vec2 pattern_uv = rotated_position / (pattern_size * pattern_scale) + vec2(0.5) + scroll_offset;
	vec4 pattern = texture(pattern_texture, pattern_uv);
	float mask_alpha = texture(mask_texture, UV).a;
	COLOR = vec4(pattern.rgb, pattern.a * mask_alpha) * COLOR;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_pattern_mask"]
shader = SubResource("Shader_pattern_mask")
shader_parameter/pattern_texture = ExtResource("7_pattern")
shader_parameter/mask_texture = ExtResource("6_menu_rect")
shader_parameter/pattern_scale = 0.65
shader_parameter/pattern_rotation_degrees = 41.0
shader_parameter/scroll_offset = Vector2(0, 0)

